-- SPEED GLITCH
-- ═══════════════════════════════════════════
local G = false
local K = {}
local H = {WaterBalloon2024=true, SnowballToy2020=true, IceCream=true}
local function B(char)
    local hum = char:WaitForChild("Humanoid")
    local hrp = char:WaitForChild("HumanoidRootPart")
    if char:FindFirstChild("GlitchPart") then char.GlitchPart:Destroy() end
    local gp = Instance.new("Part")
    gp.Name = "GlitchPart"
    gp.Size = Vector3.new(2,2,2)
    gp.Transparency = 1
    gp.CanCollide = false
    gp.CanTouch = false
    gp.CanQuery = false
    gp.Parent = char
    local weld = Instance.new("Weld")
    weld.Part0 = hrp
    weld.Part1 = gp
    weld.Parent = gp
    local function setOffset(offset) weld.C0 = CFrame.new(0,0,offset) end
    local current = nil
    local active = false
    local offsetVal = 0
    local currentTool = nil
    local climbing = false
    local inAnim = false
    local wasTool = false
    local animMap = {
        ["http://www.roblox.com/asset/?id=15609995579"] = "normal",
        ["rbxassetid://15609995579"] = "normal",
        ["rbxassetid://107481557610007"] = "forte"
    }
    local function activate(v) active = true offsetVal = v gp.Transparency = 1 setOffset(v) end
    local function reset() active = false climbing = false offsetVal = 0 inAnim = false wasTool = false gp.Transparency = 1 setOffset(0) end
    local conn1 = hum.AnimationPlayed:Connect(function(track)
        if track.Animation then
            local tipo = animMap[track.Animation.AnimationId]
            if tipo then
                current = tipo
                offsetVal = 0
                inAnim = false
                wasTool = false
                track.Stopped:Connect(function()
                    current = nil
                    inAnim = true
                    wasTool = currentTool ~= nil
                end)
            end
        end
    end)
    local conn2 = char.ChildRemoved:Connect(function(child)
        if H[child.Name] then
            if current == "normal" then offsetVal = 10.5
            elseif current == "forte" then offsetVal = 26.5 end
            if active then setOffset(offsetVal) end
        end
        if child:IsA("Tool") then
            if child == currentTool then
                currentTool = nil
                if inAnim and wasTool then
                    inAnim = false; wasTool = false; reset()
                elseif not current and not H[child.Name] then
                    reset()
                end
            end
        end
    end)
    local conn3 = char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            currentTool = child
            if inAnim and not wasTool then inAnim = false; reset(); return end
            local isClimbing = hum:GetState() == Enum.HumanoidStateType.Climbing
            if isClimbing then
                climbing = true; active = true; setOffset(3.5)
            elseif current == "normal" then
                if offsetVal > 0 then activate(offsetVal) else activate(7.5) end
            elseif current == "forte" then
                if offsetVal > 0 then activate(offsetVal) else activate(10.5) end
            end
        end
    end)
    table.insert(K, conn1); table.insert(K, conn2); table.insert(K, conn3)
    task.spawn(function()
        while char.Parent and G do
            task.wait(.05)
            if active then
                if climbing then setOffset(3.5) else setOffset(offsetVal) end
            end
        end
    end)
end
