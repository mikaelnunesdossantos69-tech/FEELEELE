    else
        x.Text = "Speed: Desativado"
        x.BackgroundColor3 = p
        if t then t:Disconnect() t = nil end
        for _, conn in ipairs(K) do conn:Disconnect() end
        table.clear(K)
        if M.Character and M.Character:FindFirstChild("GlitchPart") then
            M.Character.GlitchPart:Destroy()
        end
    end
end)

