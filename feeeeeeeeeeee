-- 🍎 ANIMAÇÃO ESTILO IPHONE + MIN/MAX ANIMADO
-- ═══════════════════════════════════════════
local panelOpen = true
local panelMinimizado = false
local animando = false
local posicaoBase = UDim2.new(0.5,0,0.5,0)

local function animarAltura(novaAltura, duracao, estilo, direcao)
    local posAtual = c.Position
    local sizeAtual = c.Size
    local topoY = posAtual.Y.Offset - sizeAtual.Y.Offset * c.AnchorPoint.Y
    local novoY = topoY + novaAltura * c.AnchorPoint.Y
    local tween = TweenService:Create(c,
        TweenInfo.new(duracao, estilo, direcao), {
            Size = UDim2.new(sizeAtual.X.Scale, sizeAtual.X.Offset, 0, novaAltura),
            Position = UDim2.new(posAtual.X.Scale, posAtual.X.Offset, posAtual.Y.Scale, novoY)
        })
    tween:Play()
    return tween
end

local function abrirPainel()
    if panelOpen or animando then return end
    animando = true
    c.Visible = true
    c.Size = TAM_FECHADO
    c.Position = posicaoBase
    panelMinimizado = false
    f.Visible = true
    u.Text = "-"
    u.BackgroundColor3 = p
    local tween = TweenService:Create(c,
        TweenInfo.new(0.45,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
        {Size=TAM_ABERTO, Position=posicaoBase})
    tween:Play()
    tween.Completed:Connect(function()
        animando = false
        panelOpen = true
    end)
end

local function fecharPainel()
    if not panelOpen or animando then return end
    animando = true
    posicaoBase = c.Position
    local posAtual = c.Position
    local centroY = posAtual.Y.Offset
    local tween = TweenService:Create(c,
        TweenInfo.new(0.25,Enum.EasingStyle.Back,Enum.EasingDirection.In), {
            Size = TAM_FECHADO,
            Position = UDim2.new(posAtual.X.Scale, posAtual.X.Offset, posAtual.Y.Scale, centroY)
        })
    tween:Play()
    tween.Completed:Connect(function()
        c.Visible = false
        animando = false
        panelOpen = false
    end)
end

