local function criarFloco()
    local floco = Instance.new("Frame")
    local tamanho = math.random(4,8)
    floco.Size = UDim2.new(0,tamanho,0,tamanho)
    floco.BackgroundColor3 = Color3.fromRGB(255,255,255)
    floco.BackgroundTransparency = math.random(5,30)/100
    floco.BorderSizePixel = 0
    floco.ZIndex = 1
    floco.Position = UDim2.new(math.random(),0,-0.15,0)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1,0)
    corner.Parent = floco

    floco.Parent = snowLayer

    local function cair()
        if not floco.Parent then return end
        local duracao = math.random(4,9)
        local destinoX = math.random()
        floco.Position = UDim2.new(math.random(),0,-0.15,0)
        local tween = TweenService:Create(floco,TweenInfo.new(duracao,Enum.EasingStyle.Linear),{
            Position = UDim2.new(destinoX,0,1.15,0)
        })
        tween:Play()
        tween.Completed:Connect(function()
            if floco.Parent then cair() end
        end)
    end
    cair()
end

for idx = 1,60 do
